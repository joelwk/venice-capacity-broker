# Copy to `docker/.env.local`, fill secrets, and keep the copy out of version control.
#
# This file is intentionally secrets-only.
#
# It should mirror the variables you store in Replit Secrets (same names).

# --- Required (Broker starts) ---
BROKER_ADMIN_TOKEN=
SESSION_SECRET=
VENICE_API_KEY=
VENICE_PARENT_KEY=
SQL_DATABASE_URL=

# --- Optional (recommended) ---
BROKER_ADMIN_TOKEN_READONLY=
SQL_DATABASE_URL_READONLY=

# --- Optional (live agents / wallet) ---
ETH_PRIVATE_KEY=
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
CDP_WALLET_SECRET=
CDP_API_KEY_NAME=
CDP_API_KEY_PRIVATE_KEY=

# --- Optional (integrations) ---
ETHERSCAN_API_KEY=
OPENAI_API_KEY=
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=
TWITTER_BEARER_TOKEN=

# --- Optional (Replit KV API alternative to REPLIT_DB_URL) ---
KV_URL=
KV_API_TOKEN=
