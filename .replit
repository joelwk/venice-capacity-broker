run = "if ! command -v uv >/dev/null 2>&1; then curl -LsSf https://astral.sh/uv/install.sh | sh; fi; export PATH=\"$PWD/.local/bin:$HOME/.local/bin:$PATH\"; EXTRA_FLAGS=\"\"; if [ -n \"$UV_EXTRAS\" ]; then for e in $UV_EXTRAS; do EXTRA_FLAGS=\"$EXTRA_FLAGS --extra $e\"; done; fi; uv sync $EXTRA_FLAGS && uv run uvicorn app:app --app-dir apps/broker-api --host 0.0.0.0 --port 5000"
language = "python3"
entrypoint = "apps/broker-api/app.py"
modules = ["python-3.10"]

[deployment]
run = [
  "sh",
  "-c",
  "pip install -r requirements.txt && uvicorn app:app --app-dir apps/broker-api --host 0.0.0.0 --port $PORT"
]

[nix]
packages = ["libxcrypt"]
channel = "stable-25_05"

[[ports]]
localPort = 8000
externalPort = 80

[[ports]]
localPort = 5000
externalPort = 80

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Run Venice Broker API"
author = 38779469
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "if ! command -v uv >/dev/null 2>&1; then curl -LsSf https://astral.sh/uv/install.sh | sh; fi; export PATH=\"$PWD/.local/bin:$HOME/.local/bin:$PATH\"; EXTRA_FLAGS=\"\"; if [ -n \"$UV_EXTRAS\" ]; then for e in $UV_EXTRAS; do EXTRA_FLAGS=\"$EXTRA_FLAGS --extra $e\"; done; fi; uv sync $EXTRA_FLAGS && uv run uvicorn app:app --app-dir apps/broker-api --host 0.0.0.0 --port 5000"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "broker-api"

[[workflows.workflow]]
name = "broker-api"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "/home/runner/workspace/.local/bin/uv run uvicorn app:app --app-dir apps/broker-api --host 0.0.0.0 --port 5000"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[agent]
expertMode = true
