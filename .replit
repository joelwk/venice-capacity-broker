run = "CORS_ENABLED=${CORS_ENABLED:-true} CORS_ALLOW_ORIGINS=${CORS_ALLOW_ORIGINS:-https://capacity-broker.replit.app} QUOTES_ENABLED=${QUOTES_ENABLED:-true} PURCHASES_ENABLED=${PURCHASES_ENABLED:-true} RUN_STACK_MODE=dry REFLEX_ALLOW_INACTIVE_STAKE=${REFLEX_ALLOW_INACTIVE_STAKE:-1} AUTOSTART_TOKEN_WATCHER_ALLOW_NO_KEY=${AUTOSTART_TOKEN_WATCHER_ALLOW_NO_KEY:-1} AUTOSTART_BROKER_PORT=${AUTOSTART_BROKER_PORT:-${PORT:-8000}} bash scripts/run_stack_entry.sh"
language = "python3"
entrypoint = "apps/broker-api/app.py"
modules = ["python-3.10"]

[[runnable]]
name = "Stack (dry-run)"
command = "CORS_ENABLED=${CORS_ENABLED:-true} CORS_ALLOW_ORIGINS=${CORS_ALLOW_ORIGINS:-https://capacity-broker.replit.app} QUOTES_ENABLED=${QUOTES_ENABLED:-true} PURCHASES_ENABLED=${PURCHASES_ENABLED:-true} RUN_STACK_MODE=dry REFLEX_ALLOW_INACTIVE_STAKE=${REFLEX_ALLOW_INACTIVE_STAKE:-1} AUTOSTART_TOKEN_WATCHER_ALLOW_NO_KEY=${AUTOSTART_TOKEN_WATCHER_ALLOW_NO_KEY:-1} AUTOSTART_BROKER_PORT=${AUTOSTART_BROKER_PORT:-${PORT:-8000}} bash scripts/run_stack_entry.sh"

[[runnable]]
name = "Stack (live)"
command = "CORS_ENABLED=${CORS_ENABLED:-true} CORS_ALLOW_ORIGINS=${CORS_ALLOW_ORIGINS:-https://capacity-broker.replit.app} QUOTES_ENABLED=${QUOTES_ENABLED:-true} PURCHASES_ENABLED=${PURCHASES_ENABLED:-true} RUN_STACK_MODE=live REFLEX_ALLOW_INACTIVE_STAKE=${REFLEX_ALLOW_INACTIVE_STAKE:-1} AUTOSTART_ORCHESTRATOR_LIVE=1 AUTOSTART_STAKEMASTER_LIVE=1 AUTOSTART_BROKER_PORT=${AUTOSTART_BROKER_PORT:-${PORT:-8000}} bash scripts/run_stack_entry.sh"

[deployment]
run = [
  "bash",
  "-lc",
  "CORS_ENABLED=${CORS_ENABLED:-true} CORS_ALLOW_ORIGINS=${CORS_ALLOW_ORIGINS:-https://capacity-broker.replit.app} QUOTES_ENABLED=${QUOTES_ENABLED:-true} PURCHASES_ENABLED=${PURCHASES_ENABLED:-true} RUN_STACK_MODE=live AUTOSTART_ORCHESTRATOR_LIVE=${AUTOSTART_ORCHESTRATOR_LIVE:-1} AUTOSTART_STAKEMASTER_LIVE=${AUTOSTART_STAKEMASTER_LIVE:-1} AUTOSTART_BROKER_PORT=${AUTOSTART_BROKER_PORT:-${PORT:-8000}} bash scripts/run_stack_entry.sh",
]

[nix]
packages = ["libxcrypt"]
channel = "stable-25_05"

[[ports]]
localPort = 8000
externalPort = 80

[[ports]]
localPort = 8000
externalPort = 80

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Run Venice Stack (dry)"
author = 38779469
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "CORS_ENABLED=${CORS_ENABLED:-true} CORS_ALLOW_ORIGINS=${CORS_ALLOW_ORIGINS:-https://capacity-broker.replit.app} QUOTES_ENABLED=${QUOTES_ENABLED:-true} PURCHASES_ENABLED=${PURCHASES_ENABLED:-true} RUN_STACK_MODE=dry REFLEX_ALLOW_INACTIVE_STAKE=${REFLEX_ALLOW_INACTIVE_STAKE:-1} AUTOSTART_TOKEN_WATCHER_ALLOW_NO_KEY=${AUTOSTART_TOKEN_WATCHER_ALLOW_NO_KEY:-1} AUTOSTART_BROKER_PORT=${AUTOSTART_BROKER_PORT:-${PORT:-8000}} bash scripts/run_stack_entry.sh"

[[workflows.workflow]]
name = "Run Venice Stack (live)"
author = 38779469
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "CORS_ENABLED=${CORS_ENABLED:-true} CORS_ALLOW_ORIGINS=${CORS_ALLOW_ORIGINS:-https://capacity-broker.replit.app} QUOTES_ENABLED=${QUOTES_ENABLED:-true} PURCHASES_ENABLED=${PURCHASES_ENABLED:-true} RUN_STACK_MODE=live REFLEX_ALLOW_INACTIVE_STAKE=${REFLEX_ALLOW_INACTIVE_STAKE:-1} AUTOSTART_ORCHESTRATOR_LIVE=${AUTOSTART_ORCHESTRATOR_LIVE:-1} AUTOSTART_STAKEMASTER_LIVE=${AUTOSTART_STAKEMASTER_LIVE:-1} AUTOSTART_BROKER_PORT=${AUTOSTART_BROKER_PORT:-${PORT:-8000}} bash scripts/run_stack_entry.sh"
