run = "RUN_STACK_MODE=dry REFLEX_ALLOW_INACTIVE_STAKE=${REFLEX_ALLOW_INACTIVE_STAKE:-1} AUTOSTART_TOKEN_WATCHER_ALLOW_NO_KEY=${AUTOSTART_TOKEN_WATCHER_ALLOW_NO_KEY:-1} bash scripts/run_stack_entry.sh"
language = "python3"
entrypoint = "apps/broker-api/app.py"
modules = ["python-3.10"]

[[runnable]]
name = "Stack (dry-run)"
command = "RUN_STACK_MODE=dry REFLEX_ALLOW_INACTIVE_STAKE=${REFLEX_ALLOW_INACTIVE_STAKE:-1} AUTOSTART_TOKEN_WATCHER_ALLOW_NO_KEY=${AUTOSTART_TOKEN_WATCHER_ALLOW_NO_KEY:-1} bash scripts/run_stack_entry.sh"

[[runnable]]
name = "Stack (live)"
command = "RUN_STACK_MODE=live REFLEX_ALLOW_INACTIVE_STAKE=${REFLEX_ALLOW_INACTIVE_STAKE:-1} AUTOSTART_ORCHESTRATOR_LIVE=1 AUTOSTART_STAKEMASTER_LIVE=1 bash scripts/run_stack_entry.sh"

[deployment]
run = [
  "bash",
  "-lc",
  "RUN_STACK_MODE=live AUTOSTART_ORCHESTRATOR_LIVE=${AUTOSTART_ORCHESTRATOR_LIVE:-1} AUTOSTART_STAKEMASTER_LIVE=${AUTOSTART_STAKEMASTER_LIVE:-1} bash scripts/run_stack_entry.sh"
]

[nix]
