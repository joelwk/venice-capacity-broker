run = "if command -v uv >/dev/null 2>&1; then uv sync && uv run uvicorn app:app --app-dir apps/broker-api --host 0.0.0.0 --port $PORT; else pip install -r requirements.txt && uvicorn app:app --app-dir apps/broker-api --host 0.0.0.0 --port $PORT; fi"
language = "python3"
entrypoint = "apps/broker-api/app.py"
