run = "bash -lc 'bash scripts/replit_run.sh dry'"
language = "python3"
entrypoint = "apps/broker_api/app.py"
modules = ["python-3.10"]

[env]
CORS_ENABLED = "true"
CORS_ALLOW_ORIGINS = "https://capacity-broker.replit.app"
QUOTES_ENABLED = "true"
PURCHASES_ENABLED = "true"
REFLEX_ALLOW_INACTIVE_STAKE = "1"
AUTOSTART_TOKEN_WATCHER_ALLOW_NO_KEY = "1"
# AUTOSTART_BROKER_PORT set dynamically from $PORT by scripts/run_stack_entry.sh

[[runnable]]
name = "Stack (dry-run)"
command = "bash -lc 'bash scripts/replit_run.sh dry'"

[[runnable]]
name = "Stack (live)"
command = "bash -lc 'bash scripts/replit_run.sh live'"

[deployment]
run = [
  "bash",
  "-lc",
  "bash scripts/replit_run.sh live",
]

[nix]
packages = ["libxcrypt", "gnumake", "curl"]
channel = "stable-25_05"

[[ports]]
localPort = 8000
externalPort = 80

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Run Venice Stack (dry)"
author = 38779469
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/replit_run.sh dry"

[[workflows.workflow]]
name = "Run Venice Stack (live)"
author = 38779469
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/replit_run.sh live"

[agent]
expertMode = true

