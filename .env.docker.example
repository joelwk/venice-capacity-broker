# Docker-specific overrides layered on top of the shared `.env`.
# Copy to `.env.docker`, keep only non-secret overrides, and put secrets in `docker/.env.local`
# (git-ignored). Run compose with both files:
#   docker compose --env-file .env.docker --env-file docker/.env.local up

BROKER_ADMIN_TOKEN=change-me
VENICE_API_BASE_URL=https://api.venice.ai/api/v1
VENICE_PARENT_KEY=
VENICE_API_KEY=
SQL_DATABASE_URL=postgresql+psycopg2://postgres:postgres@postgres:5432/postgres
REDIS_URL=redis://redis:6379/0
CORS_ENABLED=false
CORS_ALLOW_ORIGINS=

# Optional helpers
ETHERSCAN_API_KEY=

# Wallet / orchestrator secrets (only if you run live agents)
ETH_PRIVATE_KEY=
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
CDP_WALLET_SECRET=
CDP_API_KEY_NAME=
CDP_API_KEY_PRIVATE_KEY=

# Broker session/security
SESSION_SECRET=
BROKER_ADMIN_TOKEN_READONLY=

# Third-party integrations (match the keys you need from the legacy local.json)
OPENAI_API_KEY=
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=
TWITTER_BEARER_TOKEN=
