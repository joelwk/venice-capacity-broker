# Docker-specific overrides layered on top of the shared `.env`.
#
# Copy to `.env.docker`.
#
# Keep secrets out of this file.
# Put secrets in `docker/.env.local` (git-ignored).
#
# Compose usage:
#   docker compose --env-file .env --env-file .env.docker --env-file docker/.env.local up

# Docker service hostnames
BROKER_API_HOST=0.0.0.0
BROKER_API_PORT=8000

# CORS for local frontends
CORS_ENABLED=true
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:5173

# Redis connection (uses Docker service name 'redis')
REDIS_URL=redis://redis:6379/0
KV_REDIS_URL=redis://redis:6379/0

# Market data initialization
MARKETDATA_INIT_LIGHT=true
MARKETDATA_DEBUG_SANITY=0
