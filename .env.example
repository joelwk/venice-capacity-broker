# NETWORK_ID=base-mainnet       # or: base-sepolia
# PAYMASTER_URL=

# Venice API
# Official base URL includes /api/v1
VENICE_API_BASE_URL=https://api.venice.ai/api/v1
VENICE_API_KEY=7FdTCrTxHSKVtXwg5djnZLW4EMFcjFxpTpiG6fBDkx
VENICE_CREATE_ROOT_PATH=/api_keys/generate_web3_key
VENICE_CREATE_SUBKEY_PATH=/api_keys
VENICE_REVOKE_KEY_PATH=/api_keys/{key_id}
VENICE_CHALLENGE_PATH=/api_keys/generate_web3_key
VENICE_PARENT_KEY=7FdTCrTxHSKVtXwg5djnZLW4EMFcjFxpTpiG6fBDkx
VENICE_USAGE_PATH=/api_keys/rate_limits/log
VENICE_RATE_LIMITS_PATH=/api_keys/rate_limits
VENICE_QUOTA_PATH=/api_keys/rate_limits
VENICE_MODELS_PATH=/models
VENICE_CHAT_COMPLETIONS_PATH=/chat/completions
VENICE_VVV_PATH=/vvv
# Explicit VVV metrics endpoints (preferred; override if your deployment differs)
VENICE_VVV_CIRC_PATH=/vvv/circulatingsupply
VENICE_VVV_UTIL_PATH=/vvv/utilization
VENICE_VVV_YIELD_PATH=/vvv/staking_yield
# Dev-only: allow Broker /v1/market/signals to return stubbed data when Venice endpoints are unavailable
VENICE_OFFLINE_SIGNALS=false
VENICE_API_KEY_TYPE=INFERENCE
# Default model for chat (used if client omits 'model')
BROKER_DEFAULT_MODEL=qwen3-235b
VENICE_DEFAULT_MODEL=qwen3-235b

# Contracts & DEX
VVV_TOKEN_ADDRESS=0xacfE6019Ed1A7Dc6f7B508C02d1b04ec88cC21bf
VVV_STAKING_ADDRESS=0x321b7ff75154472B18EDb199033fF4D116F340Ff
DIEM_TOKEN_ADDRESS=0xf4d97f2da56e8c3098f3a8d538db630a2606a024
DIEM_MARKET_ADDRESS=
# Convenience quote token (e.g., USDC on Base)
QUOTE_TOKEN_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
DEX_PROVIDERS=uniswap_v2,aerodrome
UNISWAP_V2_ROUTER_ADDRESS=0x4752ba5dbc23f44d87826276bf6fd6b1c372ad24
# Aerodrome V2 Router on Base mainnet (verified)
AERODROME_ROUTER_ADDRESS=0xcF77a3Ba9A5CA399B7c97c74d54e5b1Beb874E43
AERODROME_STABLE=false
ROUTER_ADDRESS=0x4752ba5dbc23f44d87826276bf6fd6b1c372ad24
TRADE_PATH=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913,0xf4d97f2da56e8c3098f3a8d538db630a2606a024

SLIPPAGE_BPS=100
RISK_MAX_SLIPPAGE_BPS=150

# Broker API
BROKER_API_HOST=127.0.0.1
BROKER_API_PORT=8000
BROKER_STORE_FILE=apps/broker-api/tenants.json
# Use SQL store instead of JSON: set to 'sql' and configure DB envs
BROKER_STORE_BACKEND=json
BROKER_ADMIN_TOKEN=
# Require admin token in production
BROKER_REQUIRE_ADMIN_TOKEN=true
# Optional: base URL for CLI admin commands (overrides host/port)
BROKER_BASE_URL=
# Defaults for subkey issuance (optional)
BROKER_DEFAULT_QUOTA=0
BROKER_DEFAULT_EXPIRY_DAYS=0

# Replit SQL Database (Postgres)
# Prefer a single URL if provided by Replit Deployments
SQL_DATABASE_URL=
# Or configure via discrete settings (used if URL is empty)
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
# Optional SQLAlchemy tuning
DATABASE_POOL_SIZE=5
DATABASE_ECHO=false

# Replit KV Store
KV_URL=
KV_API_TOKEN=
KV_NAMESPACE=
KV_PREFIX=vvv:
# Optional: Redis URL for atomic counters (preferred for limiter)
REDIS_URL=
# Default TTLs for counters/idempotency (seconds)
KV_DEFAULT_TTL_SECONDS=86400
IDEMPOTENCY_TTL_SECONDS=300

# KV -> SQL compaction (env-gated)
KV_SQL_COMPACTION_ENABLED=false
KV_COMPACTION_PREFIX=rl:tenant:
KV_COMPACTION_DELETE=false

# Rate limits (KV sliding-window)
RATE_LIMITS_ENABLED=false
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=60

# Metrics / Observability
METRICS_BACKEND=auto        # auto|starlette|builtin|off
METRICS_PATH=/metrics
# LangSmith tracing (for LangGraph/agents)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=

# Optional: LiteLLM proxy behind /v1/chat
LITELLM_PROXY_BASE_URL=
LITELLM_API_KEY=

# Buyer Flow / Pricing (flag-gated)
# Toggle features (off by default). Enable quotes and purchases endpoints and CORS for the buyer/admin origins.
QUOTES_ENABLED=true
PURCHASES_ENABLED=true
CORS_ENABLED=true
CORS_ALLOW_ORIGINS=true

# Pricing engine (static). Prices are "per unit" in minor units for the chosen asset.
# USDC example (6 decimals): 100000 = 0.1 USDC per unit
PRICE_UNIT_USDC=100000
# ETH example in wei (leave 0 to disable ETH pricing)
PRICE_UNIT_ETH_WEI=0
PRICE_ACCEPTED_MIN_UNITS=1
PRICE_ACCEPTED_MAX_UNITS=100000
PRICE_QUOTE_TTL_SECONDS=120
# Pricing engine and utilization feedback
PRICE_ENGINE=static           # static|market
PRICE_UTIL_ALPHA=0.5          # 0..1 multiplier based on utilization
PRICE_UTIL_LOOKBACK_MIN=60    # minutes to look back for utilization
CAPACITY_UNITS_PER_MIN=100    # capacity baseline per minute used by utilization

# Payments & assets
ACCEPT_ASSETS=ETH,USDC
TREASURY_ADDRESS=0xe6e24e8E6F3004D82F0C710f6Bb035af1bE730C1
USDC_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913  # Base mainnet USDC
PURCHASE_UNITS_KIND=diem

# Token watcher (BaseScan / Etherscan)
# API key from https://basescan.org/myapikey
#ETHERSCAN_API_KEY=
# Optional: override endpoint or reuse ETHERSCAN_API_KEY
# BASESCAN_API_URL=https://api.basescan.org/api
#TOKEN_WATCH_ADDRESSES=,
TOKEN_WATCH_INTERVAL_SECONDS=300

# Risk / Portfolio exposure (optional)
RISK_ENABLE_PORTFOLIO_CAP=false
# Inventory in base units (optional)
DIEM_INVENTORY_UNITS=0
VVV_INVENTORY_UNITS=0
USDC_INVENTORY_UNITS=0
# Risk sizing modifiers (optional)
# Multiplier = 1 + alpha * utilization (0..1)
RISK_UTIL_ALPHA=0.5
# Cap units when realized vol exceeds cap (bps); 0 = disabled
RISK_MAX_VOLATILITY_BPS=0

# DIEM mint/burn capacity gate (optional)
# Enable sVVV capacity pre-check before mint
DIEM_ENABLE_SVVV_GATE=false
# sVVV base units required per 1 DIEM base unit (integer)
DIEM_MINT_RATE_SVVV_PER_DIEM=
# Alternatively, sVVV tokens per 1 DIEM token (float, decimals-aware)
DIEM_MINT_RATE=
# Override available sVVV base units for locking (int)
DIEM_SVVV_AVAILABLE_UNITS=
# Decimals (defaults 18 if unset)
DIEM_DECIMALS=
SVVV_DECIMALS=

# Pause all agents (orchestrator respects this)
AGENTS_PAUSED=false
