AERODROME_STABLE=false
AERODROME_EXACT_OUT_ENABLE=0

# ==============================================================================
# DEX AGGREGATOR CONFIGURATION
# ==============================================================================
DEX_PROVIDERS=uniswap_v3,aerodrome,uniswap_v2,aerodrome_cl
DEX_EXEC_PROVIDERS=aerodrome_cl,aerodrome,uniswap_v2,uniswap_v3
DEX_AGGREGATOR_MAX_WORKERS=3
DEX_MAX_WORKERS=3
DEX_COMPOSITE_ENABLE=1

# Timeouts
DEX_PROVIDER_TIMEOUT_SECONDS=10
DEX_PROVIDER_TIMEOUT_SECONDS_DIEM=8
DEX_AGGREGATE_TIMEOUT_SECONDS=20
DEX_AGGREGATE_TIMEOUT_SECONDS_DIEM=10
DEX_FIRST_QUOTE_LINGER_MS=80
DEX_EARLY_EXIT_FIRST_QUOTE=1

# Circuit breaker
DEX_CIRCUIT_FAILURES=3
DEX_CIRCUIT_FAILURE_THRESHOLD=5
DEX_CIRCUIT_COOL_OFF_SECONDS=60
DEX_CIRCUIT_COOL_SECONDS=30
DEX_CIRCUIT_BACKOFF_MULT=2.0
DEX_CIRCUIT_MAX_COOL_SECONDS=300

# Rate limiting
DEX_RATE_LIMIT_QPS=0
DEX_RATE_LIMIT_BURST=0
DEX_BRIDGE_TOKEN_ADDRESS=

# ==============================================================================
# TRADE PATH CONFIGURATION
# ==============================================================================
# Sell path: DIEM -> VVV -> USDC (bridge-only)
TRADE_PATH=0xf4d97f2da56e8c3098f3a8d538db630a2606a024,0xacfE6019Ed1A7Dc6f7B508C02d1b04ec88cC21bf,0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
TRADE_PATHS_DYNAMIC=false
TRADE_PATH_DISCOVERY_TIMEOUT=10
TRADE_PATH_DIRECT_MIN_LIQ_USD=5000
TRADE_PATH_HOP_MIN_LIQ_USD=1500
PATH_ENGINE_SOFT_TIMEOUT_SECONDS=12.0
PATH_LIQUIDITY_FLOOR_USD=
PATH_STALE_ROUTE_PENALTY_BPS=

# ETH price path: Direct WETH -> USDC route (avoids broken multi-hop discovery)
# Uses canonical UniswapV3 WETH/USDC pool with 500 bps fee tier
ETH_PRICE_PATH=0x4200000000000000000000000000000000000006->0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913

# WETH/USDC pool configuration for ETH pricing (optional)
# Set to UniswapV3 WETH/USDC pool address on Base if needed for explicit routing
# Common fee tiers: 500 (0.05%), 3000 (0.3%), 10000 (1%)
# WETH_USDC_POOL_ADDRESS=
WETH_USDC_POOL_FEE=500

# WBTC price path: WBTC -> WETH -> USDC (2-hop via WETH)
# Required when WBTC_TOKEN_ADDRESS is set to avoid fallback warnings
WBTC_PRICE_PATH=0x0555E30da8f98308EdB960aa94C0Db47230d2B9c->0x4200000000000000000000000000000000000006->0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913

# Bridge providers
DIEM_VVV_BRIDGE_PROVIDER=aerodrome
VVV_USDC_BRIDGE_PROVIDER=uniswap_v3

# Slippage
SLIPPAGE_BPS=200
RISK_MAX_SLIPPAGE_BPS=500
RISK_MAX_POOL_TAKE_BPS=10

# ==============================================================================
# DIEM ROUTING & EXECUTION
# ==============================================================================
DIEM_PREFER_DIRECT_ROUTE=1
DIEM_BUY_EXECUTION_MODE=exact_in
DIEM_SELL_EXECUTION_MODE=exact_in
DIEM_TWO_STAGE_EXECUTION=1
DIEM_EXACT_IN_FALLBACK_ENABLE=1
