# ==============================================================================
# Venice Capacity Broker - Environment Configuration
# ==============================================================================
# Copy this file to .env and .env.local, then fill in secrets.
# For Replit: use Secrets pane for sensitive values marked <set-in-secrets>
# ==============================================================================

# ==============================================================================
# LOGGING
# ==============================================================================
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s | %(levelname)s | %(component)s | %(message)s
LOG_FILE=
LOG_DIR=logs
LOG_CAPTURE_CONSOLE=true

# ==============================================================================
# NETWORK (Base L2)
# ==============================================================================
APP_ENV=production
BASE_RPC_URL=
BASE_RPC_URLS=
RPC_URL=
RPC_URLS=
BASE_CHAIN_ID=8453
CHAIN_ID=8453
NETWORK_ID=base-mainnet
NETWORK_ID_OVERRIDES=
RPC_REQUEST_TIMEOUT_SECONDS=15
RPC_BACKOFF_BASE_SECONDS=90

# ==============================================================================
# WALLET CONFIGURATION
# ==============================================================================
WALLET_PROVIDER=eth_account
ETH_PRIVATE_KEY=<set-in-secrets>
ETH_PRIVATE_KEY_PATH=
CDP_API_KEY_ID=<set-in-secrets>
CDP_API_KEY_SECRET=<set-in-secrets>
CDP_WALLET_SECRET=<set-in-secrets>
CDP_API_KEY_NAME=<set-in-secrets>
CDP_API_KEY_PRIVATE_KEY=<set-in-secrets>
OWNER=
OWNER_ADDRESS=
PAYMASTER_URL=
PAYMASTER_RPC_URL=

# ==============================================================================
# VENICE API
# ==============================================================================
VENICE_API_BASE_URL=https://api.venice.ai/api/v1
VENICE_API_KEY=<set-in-secrets>
VENICE_PARENT_KEY=<set-in-secrets>
VENICE_API_KEY_TYPE=INFERENCE
VENICE_CREATE_ROOT_PATH=/api_keys/generate_web3_key
VENICE_CREATE_SUBKEY_PATH=/api_keys
VENICE_REVOKE_KEY_PATH=/api_keys/{key_id}
VENICE_CHALLENGE_PATH=/api_keys/generate_web3_key
VENICE_USAGE_PATH=/api_keys/rate_limits/log
VENICE_RATE_LIMITS_PATH=/api_keys/rate_limits
VENICE_QUOTA_PATH=/api_keys/rate_limits
VENICE_MODELS_PATH=/models
VENICE_CHAT_COMPLETIONS_PATH=/chat/completions
VENICE_VVV_PATH=/vvv
VENICE_VVV_CIRC_PATH=/vvv/circulatingsupply
VENICE_VVV_UTIL_PATH=/vvv/utilization
VENICE_VVV_YIELD_PATH=/vvv/staking_yield
VENICE_OFFLINE_SIGNALS=false
VENICE_DEFAULT_MODEL=venice-uncensored
VENICE_HEARTBEAT_MODEL=venice-uncensored
BROKER_DEFAULT_MODEL=qwen3-4b

# ==============================================================================
# TOKEN ADDRESSES (Base L2)
# ==============================================================================
