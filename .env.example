# Logging
LOG_LEVEL=INFO

# Network (Base)
BASE_RPC_URL=https://mainnet.base.org
BASE_CHAIN_ID=8453

# Wallet configuration
# WALLET_PROVIDER=eth_account   # or: smart_wallet
# ETH_PRIVATE_KEY=
