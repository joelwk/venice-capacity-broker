# DEX behavior
AERODROME_STABLE=false
AERODROME_EXACT_OUT_ENABLE=0
# CRITICAL: DEX_FORCE_V2_FOR_CANONICAL must be 0 to allow aerodrome_cl direct pool execution
# When set to 1, aerodrome_cl gets skipped with reason 'force_v2_canonical' 
DEX_FORCE_V2_FOR_CANONICAL=0
UNISWAP_V3_SQRT_PRICE_LIMIT=0

# Timeouts
DEX_AGGREGATE_TIMEOUT_SECONDS=8
DEX_PROVIDER_TIMEOUT_SECONDS=5
DEX_PROVIDER_TIMEOUT_SECONDS_DIEM=8
DEX_AGGREGATE_TIMEOUT_SECONDS_DIEM=10
DEX_EARLY_EXIT_FIRST_QUOTE=1
DEX_SLOT0_CACHE_TTL_SECONDS=10
DEX_AGGREGATOR_MAX_WORKERS=3
ETHERSCAN_TIMEOUT_SECONDS=8
ETHERSCAN_MAX_RETRIES=1

# Circuit breaker settings
DEX_CIRCUIT_FAILURE_THRESHOLD=5
DEX_CIRCUIT_COOL_SECONDS=30

# ==========================
# DIEM TRADE PATHS
# ==========================
# CRITICAL: Do NOT set TRADE_PATH or TRADE_PATH_BUY - let dynamic discovery use the direct DIEM/USDC route!
# When these are set to 3-hop bridge routes (DIEM->VVV->USDC), they override the direct route
# and cause extreme slippage (~9200 bps) because the bridge providers can't execute them properly.
# 
# The direct DIEM/USDC Aerodrome SlipStream pool at 0xBc323103... has ~$120K liquidity
# and is injected automatically as PRIORITY 0 when DIEM_PREFER_DIRECT_ROUTE=1.
#
# Old 3-hop routes (DO NOT USE):
# TRADE_PATH=0xF4D97F2Da56E8C3098F3A8D538Db630A2606A024,0xacfE6019Ed1A7Dc6f7B508C02d1b04ec88cC21bf,0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
# TRADE_PATH_BUY=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913,0xacfE6019Ed1A7Dc6f7B508C02d1b04ec88cC21bf,0xF4D97F2Da56E8C3098F3A8D538Db630A2606A024

# Dynamic trade path discovery (required when TRADE_PATH/TRADE_PATH_BUY are not set)
TRADE_PATHS_DYNAMIC=true

# ==========================
# DIEM ROUTING & FALLBACKS
# ==========================
# Core DIEM settings
DIEM_DECIMALS=18
SVVV_DECIMALS=18
DIEM_TARGET_SUPPLY=38000
DIEM_ENABLE_SVVV_GATE=1

# Bridge provider settings (critical for production)
# DIEM/VVV uses Aerodrome V2-compatible pool (0xbB345D35...)
DIEM_VVV_BRIDGE_PROVIDER=aerodrome
# VVV/USDC uses Aerodrome CL SlipStream pool at 0x67A11022... with 3000 bps (0.3%) fee
# UniswapV3 quoter fails for this pool; aerodrome_cl works correctly
VVV_USDC_BRIDGE_PROVIDER=aerodrome_cl
VVV_USDC_V2_FALLBACK_ENABLE=1
VVV_USDC_V2_FALLBACK_ONLY_FOR_BUYS=0
DIEM_ENABLE_PAIR_MATH_FALLBACK=1
DIEM_VVV_DIRECT_SWAP_ENABLE=1
DIEM_VVV_USDC_V3_SLOT0_FALLBACK_ENABLE=1
DIEM_VVV_USDC_V3_ANALYTIC_FALLBACK_ENABLE=1
BRIDGE_LEG2_TIMEOUT_SECONDS=6.0
# Minimum VVV amount for bridge leg2 quotes (below this, skip to avoid empty quotes)
BRIDGE_LEG2_MIN_VVV_UNITS=50000000000000000

# Route policy
DIEM_DISABLE_CANONICAL_WETH=1
DIEM_MAX_ROUTE_HOPS=2
DIEM_ROUTE_AVOID_WETH=1
DIEM_ENABLE_V2_MULTIHOP=1
DIEM_ENABLE_THREE_HOP_WETH=0
DIEM_PREFER_DIRECT_ROUTE=1
DIEM_BUY_DIRECT_ONLY=1
DIEM_BUY_AMOUNT_IN_SANITY_ENABLE=1
DIEM_BUY_AMOUNT_IN_SANITY_THRESHOLD=2.0
DIEM_TRADE_EFFICIENCY_ALERT_THRESHOLD=1.5

# Execution modes (exact_in for both - matches Docker config)
DIEM_BUY_EXECUTION_MODE=exact_in
DIEM_SELL_EXECUTION_MODE=exact_in
DIEM_BUY_EXACT_IN_MAX_CUMULATIVE_SCALE=3.0

# Exact-in fallback (when exact-out fails)
DIEM_EXACT_IN_FALLBACK_ENABLE=1
# Enable buy fallback when primary routes fail
DIEM_ACTIONS_BUY_FALLBACK_ENABLE=1
DIEM_EXACT_IN_FALLBACK_MAX_USD=10.0
DIEM_EXACT_IN_FALLBACK_MAX_SLIPPAGE_BPS=400
DIEM_BUY_FALLBACK_WHEN_BRIDGE_HEALTHY=1

# Bridge live fallback (use reserve-based pricing when router quotes fail/incoherent)
DIEM_BRIDGE_LIVE_FALLBACK_ENABLE=1
DIEM_BRIDGE_LIVE_FALLBACK_MAX_USD=10.0
DIEM_BRIDGE_LIVE_FALLBACK_SLIPPAGE_BPS=100.0

# Route coherence (prevents incoherent pricing between routes)
DIEM_ROUTE_COHERENCE_MAX_REL_DIFF=500.0
DIEM_ROUTE_COHERENCE_SKIP_BRIDGE=1

# Route muting (prevents repeated failures)
DIEM_ROUTE_REVERT_BAN_ENABLE=1
DIEM_ROUTE_REVERT_BAN_THRESHOLD=2
DIEM_ROUTE_REVERT_BAN_TTL_SECONDS=1800
DIEM_CANONICAL_ROUTE_REVERT_BAN_THRESHOLD=5
DIEM_CANONICAL_ROUTE_REVERT_BAN_TTL_SECONDS=1800

# Burn handling
DIEM_SKIP_BURN_IF_NO_LOCKED_SVVV=1

# ==========================
# MARKET DATA
# ==========================
# Default aligns with the broker UI expectations (frontend aborts around 20s).
# Override upward only when doing deep diagnostics; prefer returning partial prices quickly.
MARKETDATA_PRICES_TIMEOUT_SECONDS=20
# Warmup timeout for startup cache priming (runs in background).
# This can exceed MARKETDATA_PRICES_TIMEOUT_SECONDS because it does not block HTTP readiness.
BROKER_WARMUP_MARKETDATA_TIMEOUT_SECONDS=30
MARKETDATA_DEBUG_SANITY=0
MARKETDATA_PRICE_SANITY_MAX_DRIFT=0.30
MARKETDATA_SANITY_THRESHOLD=0.15
MARKETDATA_PATH_ENGINE_TIMEOUT_SECONDS=10.0
MARKETDATA_EXTERNAL_PRICE_TTL_SECONDS=60
MARKETDATA_ROUTE_QUOTE_TTL_SECONDS=2.0
MARKETDATA_PRICE_CACHE_TTL_DIEM_SECONDS=30
MARKETDATA_PRICE_CACHE_TTL_USDC_SECONDS=300
MARKETDATA_PRICE_CACHE_MAX_SYMBOLS=64

# External price fast path: symbols listed here try external prices (DexScreener) first
# before slow DEX lookups. This prevents these symbols from timing out and blocking the
# entire price batch. Comma-separated, case-insensitive. Set to empty to disable.
MARKETDATA_EXTERNAL_FIRST_SYMBOLS=ETH,WBTC

# Path engine tuning
PATH_ENGINE_ROUTE_CACHE_TTL_SECONDS=60.0
PATH_ENGINE_PROVIDER_TIMEOUT_THRESHOLD=3
PATH_ENGINE_PROVIDER_BACKOFF_SECONDS=180.0
PATH_ENGINE_MIN_ROUTE_BUDGET_SECONDS=0.35
PATH_ENGINE_SOFT_TIMEOUT_MARGIN_SECONDS=0.75
PATH_ENGINE_ROUTE_WORKERS=2

# Pool watcher
POOL_WATCH_BACKFILL_BLOCKS=200
POOL_WATCH_BLOCK_SPAN=500

# ==========================
# RISK MANAGEMENT
# ==========================
# Slippage and pool impact
SLIPPAGE_BPS=200
RISK_MAX_SLIPPAGE_BPS=500
RISK_DIEM_SLIPPAGE_HARD_CAP_BPS=500
RISK_MAX_POOL_TAKE_BPS=10.0
DIEM_SELL_SLIPPAGE_BPS=150
DIEM_BUY_SLIPPAGE_BPS=200

# Skip DIEM dust sells (base units, 18 decimals)
DIEM_MIN_SELL_UNITS=1000000000000000

# Trade sizing (smaller trades to fit within wallet balance)
RISK_MAX_DIEM_TRADE_UNITS=5e17
RISK_MAX_DIEM_TRADE_USD=10000.0
ARBI_DIEM_TRADE_USD=0.50
ARBI_DIEM_MIN_TRADE_USD=0.25

# Liquidity adjustment
ARBI_DIEM_LIQUIDITY_MIN_TRADE_USD=0.15
ARBI_DIEM_LIQUIDITY_MAX_ADJUST_STEPS=3

# Volatility and utilization
# Note: RISK_MAX_VOLATILITY_BPS=0 disables volatility-based sizing cap in default.yml
RISK_MAX_VOLATILITY_BPS=0
RISK_UTIL_ALPHA=0.5

# DIEM fair value thresholds
DIEM_PREMIUM_THRESHOLD=1.25
DIEM_DISCOUNT_THRESHOLD=0.0
QUORUM_WEIGHT_DEMAND=0.5
DIEM_FAIR_VALUE_HORIZON_DAYS=540
DIEM_ADOPTION_BASE=0.40
DIEM_ILLIQUIDITY_DISCOUNT=0.90
DIEM_DISCOUNT_RATE_APY=0.15
DIEM_GROWTH_RATE_APY=0.05

# Capacity recovery (locked sVVV ratio cap)
DIEM_LOCKED_SVVV_RATIO_CAP=0.65
DIEM_LOCKED_SVVV_RATIO_TARGET=0.50
DIEM_LOCKED_SVVV_RATIO_MIN_TOTAL_SVVV_UNITS=50000000000000000000
VVV_FV_PREFER_STAKE_DISCOUNT_MULT=1.15

# ArbiDiem pacing controls
ARBI_DIEM_MIN_ACTION_INTERVAL_SECONDS=300
ARBI_DIEM_MAX_MINT_SELL_PER_HOUR=12
ARBI_DIEM_RECOVERY_BYPASS_INTERVAL=0
ARBI_DIEM_RECOVERY_PREFERRED_ACTION=stake
ARBI_DIEM_RECOVERY_MAX_SLIPPAGE_BPS=500
ARBI_DIEM_RECOVERY_SMALL_TRADE_USD=5

# ==========================
# ORCHESTRATOR / AGENTS
# ==========================
# Progressive live mode
STAKEMASTER_PROGRESSIVE_ENABLE=1
STAKEMASTER_PROGRESSIVE_CYCLES=5
QUORUM_ENABLE=1
QUORUM_THRESHOLD=0.55

# StakeMaster heartbeat
STAKEMASTER_HEARTBEAT_DISABLE=0
STAKEMASTER_HEARTBEAT_INTERVAL_HOURS=48
STAKEMASTER_HEARTBEAT_PROMPT="Please respond with a single word 'alive'."
VVV_ACTIVE_MIN_STAKE_UNITS=0
