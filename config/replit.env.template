# ==========================
# REFLEX & REFLECTION
# ==========================
# Reflex guardian (runtime anomaly detection)
# Note: vol_bps in production logs show values around 0.3-0.5, max threshold set higher for headroom
REFLEX_MAX_VOL_BPS=800
REFLEX_MAX_UTILIZATION=0.92
REFLEX_MAX_PRICE_DRAWDOWN=0.20
REFLEX_APPLY_DRY_RUN=false
REFLEX_REQUIRE_ACTIVE_STAKE=false
REFLEX_STAKE_INACTIVE_CONSEC=3
REFLEX_PROVIDER_ERROR_THRESHOLD=2
REFLEX_ALLOW_INACTIVE_STAKE=1

# Reflection engine (post-cycle analysis)
# Match reflex thresholds for consistency
REFLECTION_VOL_BPS_THRESHOLD=800
REFLECTION_HOLD_STREAK=3
REFLECTION_HALT_ENABLE=true
REFLECTION_HALT_TTL_SECONDS=300

# ==========================
# BROKER API
# ==========================
BROKER_API_HOST=0.0.0.0
BROKER_API_PORT=8000

# Admin authentication
BROKER_ADMIN_TOKEN=set-in-secrets
BROKER_ADMIN_TOKEN_READONLY=
SESSION_SECRET=set-in-secrets
BROKER_REQUIRE_ADMIN_TOKEN=true

# Features
RATE_LIMITS_ENABLED=1
QUOTES_ENABLED=true
PURCHASES_ENABLED=true
BROKER_DEFAULT_MODEL=

# Pricing engine
PRICE_ENGINE=market
# UI default: keep prices cached long enough to avoid repeated cold DEX/RPC lookups.
# Low TTLs (e.g., 1-5s) can cause the buy page Market Snapshot to "spin" during bursts
# and increase odds of timeouts on cold starts.
BROKER_PRICES_TTL_SECONDS=60.0

# Pricing discounts (basis points, 100 = 1%)
# These discounts are applied to DIEM quotes to incentivize purchases.
# Set per-asset or use PRICE_DISCOUNT_DEFAULT_BPS for all assets.
PRICE_DISCOUNT_DEFAULT_BPS=500
PRICE_DISCOUNT_USDC_BPS=500
PRICE_DISCOUNT_ETH_BPS=500
PRICE_DISCOUNT_WBTC_BPS=1000

# CORS
CORS_ENABLED=true
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:5173,https://capacity-broker.replit.app

# Wallet / Treasury (required for purchases; do not use placeholder values)
TREASURY_ADDRESS=

# ==========================
# DATABASE & PERSISTENCE
# ==========================
