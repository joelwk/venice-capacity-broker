DATABASE_URL=
POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
SQL_CREATE_ALL_ON_START=false

# KV / Rate limiting
KV_URL=
KV_API_TOKEN=
REDIS_URL=
REPLIT_DB_URL=

# Fallback policies (strict for production)
ALLOW_SQLITE_FALLBACK=0
ALLOW_JSON_FALLBACK=0
ALLOW_INMEMORY_KV_FALLBACK=0

# Memory retention
MEMORY_RETENTION_DAYS=30
AGENT_MEMORY_PATH=db/agent_memory.jsonl

# ==========================
# EXTERNAL SERVICES
# ==========================
ETHERSCAN_API_KEY=
ETH_PRIVATE_KEY=
CDP_API_KEY_NAME=
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
CDP_API_KEY_PRIVATE_KEY=
CDP_WALLET_SECRET=

# OpenAI (for AI features)
OPENAI_API_KEY=

# Twitter (optional, for social features)
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=
TWITTER_BEARER_TOKEN=

# ==========================
# DEBUG FLAGS (PRODUCTION OFF)
# ==========================
DIEM_DEBUG_ROUTES=0
TEST_MODE=false
DRY_RUN=false
SKIP_UV_SYNC=1
DIEM_LOCK_FN=
DIEM_UNLOCK_FN=


# Gas refuel configuration (auto-swap assets to ETH when gas is low)
# Base gas is ~0.001 gwei, swap costs ~0.0000003 ETH, so these values fund 100-1000 txs
GAS_REFUEL_ENABLE=1
GAS_REFUEL_MIN_ETH_WEI=500000000000000
GAS_REFUEL_TARGET_ETH_WEI=1000000000000000
GAS_REFUEL_ASSET_PRIORITY=USDC,USDBC,VVV,DIEM
GAS_REFUEL_MAX_SLIPPAGE_BPS=100
GAS_REFUEL_MAX_PRICE_DEVIATION_BPS=2000

# DIEM BURNER CONFIGURATION
DIEM_MINT_FN=mintDiem
DIEM_BURN_FN=burnDiem
DIEM_MINT_GAS_LIMIT=400000
DIEM_BURN_GAS_LIMIT=400000

# New feature flags (add to orchestrator environment section)
QUOTE_TOKEN_CONSOLIDATE_ENABLE=1
QUOTE_TOKEN_CONSOLIDATE_ON_STARTUP=1
ARBI_DIEM_INVENTORY_LIQUIDATE_ENABLE=1
ARBI_DIEM_INVENTORY_LIQUIDATE_FLOOR_MULT=0.88
QUORUM_VALIDATE_HOLDS=1
STAKEMASTER_MIN_CLAIM_UNITS=0
DIEM_MINT_DISABLE_SLIPPAGE=false
DIEM_MINT_SLIPPAGE_PCT=25.0

# StakeMaster auto-stake & auto-compound settings
STAKEMASTER_AUTO_STAKE_IDLE_ENABLE=1
STAKEMASTER_AUTO_COMPOUND_ENABLE=1
STAKEMASTER_COMPOUND_ONLY_IF_CLAIMED=1
STAKEMASTER_WALLET_VVV_BUFFER_UNITS=250000000000000000
STAKEMASTER_IDLE_STAKE_MAX_PER_CYCLE_UNITS=10000000000000000000
# Idle stake minimum - lower than general min_stake_usd for optimal compounding
# Set to 0.20 for frequent small compounding, or higher to batch larger amounts
STAKEMASTER_IDLE_STAKE_MIN_USD=0.20
# Stake increment rounding (0 disables rounding).
# 100000000000000000 = 0.1 VVV if you want small rounding.
