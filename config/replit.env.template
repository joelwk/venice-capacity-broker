# --- StakeMaster: idle stake overflow backoff (panic error 0x11) ---
DEX_APPROVE_MAX=1
STAKEMASTER_IDLE_STAKE_OVERFLOW_MAX_RETRIES=6
STAKEMASTER_IDLE_STAKE_OVERFLOW_BACKOFF_MULT=0.25

# --- StakeMaster: dynamic claim gating (reward USD vs gas USD) ---
STAKEMASTER_CLAIM_GAS_BUFFER_MULT=2.0
STAKEMASTER_MIN_CLAIM_USD=0.05

# --- DIEM preview slippage sanity diagnostics ---
RISK_SLIPPAGE_SANITY_MAX_BPS=50000

# --- Capacity recovery (locked sVVV ratio policy) ---
# Disable by default: 1.0 means “never trigger recovery”.
DIEM_LOCKED_SVVV_RATIO_CAP=0.65


# Optional hysteresis target. If unset in code, it defaults to cap.
# If you enable recovery, set target < cap (e.g., cap=0.85 target=0.75).
DIEM_LOCKED_SVVV_RATIO_TARGET=0.50

# Minimum total sVVV (base units, 18 decimals) before ratio enforcement applies.
# Default 0 = always eligible.
DIEM_LOCKED_SVVV_RATIO_MIN_TOTAL_SVVV_UNITS=50000000000000000000

# --- Capacity recovery trade sizing ---
# Default follows the shared liquidity min trade floor if unset, but set explicitly for clarity.
DIEM_RECOVERY_MIN_TRADE_USD=2.0

# Max trade USD for recovery operations (matches Docker orchestrator)
DIEM_RECOVERY_MAX_TRADE_USD=25.0

# Default search steps for executable sizing (halving/backoff).
DIEM_RECOVERY_MAX_STEPS=10

# --- VVV intrinsic fair value (used to pick stake-vs-unlock recovery path) ---
VVV_FV_HORIZON_DAYS=365
VVV_FV_DISCOUNT_APY=0.20

# Leave at 0.0 if you don’t want intrinsic FV to influence decisions yet.
VVV_FV_EMISSIONS_VVV_PER_DAY_PER_STAKED_VVV=0.0
VVV_FV_DIEM_PER_DAY_PER_STAKED_VVV=0.0

# $1/day semantics for DIEM utility when staked.
VVV_FV_DIEM_UTILITY_USD_PER_DIEM_DAY=1.0

# Locked sVVV emissions multiplier per tokenomics.
VVV_FV_LOCKED_EMISSIONS_MULT=0.8

# Prefer stake-based recovery when (intrinsic_fv / market_price) >= this multiple.
# 1.0 = prefer stake whenever intrinsic says “undervalued”.
VVV_FV_PREFER_STAKE_DISCOUNT_MULT=1.15
