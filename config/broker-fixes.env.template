# Venice Broker environment reference
# Updated: 2025-03-03

# Use .env for local runs.

# Use it for tests.

# Use .env.docker for docker-compose overrides.

# Keep secrets in docker/.env.local or your secrets manager.

# Local defaults (.env)
CORS_ENABLED=true
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:5173
BROKER_API_HOST=127.0.0.1
BROKER_API_PORT=8000
SQL_DATABASE_URL=postgresql://user:password@host:5432/database
REDIS_URL=redis://127.0.0.1:6379/0
DEX_FIRST_QUOTE_LINGER_MS=60
DEX_AGGREGATE_TIMEOUT_SECONDS=1.2
DEX_PROVIDER_TIMEOUT_SECONDS=0.9
RPC_REQUEST_TIMEOUT_SECONDS=5
ETHERSCAN_TIMEOUT_SECONDS=8
ETHERSCAN_MAX_RETRIES=1
MARKETDATA_INIT_LIGHT=true
MARKETDATA_DEBUG_SANITY=0
DIEM_DEBUG_ROUTES=0

# Buyer flow & feature toggles
QUOTES_ENABLED=true
PURCHASES_ENABLED=true
TREASURY_ADDRESS=<set-your-treasury-address>

# Docker overrides (.env.docker)
BROKER_API_HOST=0.0.0.0
BROKER_API_PORT=8000
